model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(APPLICANT)
  isActive     Boolean  @default(true)
  forcePasswordReset Boolean @default(false)
  passwordChangedAt DateTime?
  lastLoginAt DateTime?
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  stripeConnectAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeOnboardingComplete Boolean @default(false)
  stripeConnectLastSyncedAt DateTime?
  stripeCustomerId String? @unique
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  applicantProfile ApplicantProfile?
  applications Application[]
  uploadedDocuments Document[] @relation("UploadedDocuments")
  reviewedDocuments Document[] @relation("ReviewedDocuments")
  requestedDocuments DocumentRequest[] @relation("RequestedDocuments")
  signatureRequests SignatureRequest[]
  signatureNotifications SignatureNotification[]
  assignedInspections Inspection[] @relation("AssignedInspections")
  requestedMaintenanceRequests MaintenanceRequest[] @relation("RequestedMaintenanceRequests")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("AssignedMaintenanceRequests")
  createdMessageThreads MessageThread[] @relation("CreatedMessageThreads")
  sentMessages Message[] @relation("SentMessages")
  createdLedgerEntries LedgerEntry[] @relation("CreatedLedgerEntries")
  tenantLedgerEntries LedgerEntry[] @relation("TenantLedgerEntries")
  recurringChargeSchedules RecurringChargeSchedule[] @relation("TenantRecurringChargeSchedules")
  createdRecurringChargeSchedules RecurringChargeSchedule[] @relation("CreatedRecurringChargeSchedules")
  paymentPlans PaymentPlan[] @relation("TenantPaymentPlans")
  createdPaymentPlans PaymentPlan[] @relation("CreatedPaymentPlans")
  currentTenantUnits Unit[] @relation("CurrentTenantUnits")
  favoriteRentals FavoriteRental[]
  utilityAccounts UtilityAccount[]
  payrollReminders PayrollReminder[]
  tenantPayments TenantPayment[]
  renterPaymentMethods RenterPaymentMethod[]
  scheduledPayments ScheduledPayment[]
  paymentEvents PaymentEvent[]
  autoPayEnrollments AutoPayEnrollment[]
  paymentRetryAttempts PaymentRetryAttempt[]
  financialAdjustments FinancialAdjustment[] @relation("FinancialAdjustmentActor")
  ownerStatements OwnerStatement[] @relation("OwnerStatements")
  generatedOwnerStatements OwnerStatement[] @relation("GeneratedOwnerStatements")
  paymentDisputes PaymentDispute[] @relation("DisputeOwner")
  vendorPayouts VendorPayout[] @relation("VendorPayoutOwner")
  vendorPayoutVendorRecords VendorPayout[] @relation("VendorPayoutVendor")
  approvedVendorPayouts VendorPayout[] @relation("VendorPayoutApprover")
  vendorProfile VendorProfile? @relation("VendorProfileUser")
  ownedVendorProfiles VendorProfile[] @relation("VendorProfileOwner")
  createdVendorProfiles VendorProfile[] @relation("VendorProfileCreatedBy")
  ownedVendorInvitations VendorInvitation[] @relation("VendorInvitationOwner")
  createdVendorInvitations VendorInvitation[] @relation("VendorInvitationCreatedBy")
  acceptedVendorInvitations VendorInvitation[] @relation("VendorInvitationAcceptedBy")
  vendorWorkLogs VendorWorkLog[] @relation("VendorWorkLogVendor")
  createdVendorWorkLogs VendorWorkLog[] @relation("VendorWorkLogCreatedBy")
  vendorInvoices VendorInvoice[] @relation("VendorInvoiceVendor")
  ownedVendorInvoices VendorInvoice[] @relation("VendorInvoiceOwner")
  createdVendorInvoices VendorInvoice[] @relation("VendorInvoiceCreatedBy")
  reviewedVendorInvoices VendorInvoice[] @relation("VendorInvoiceReviewedBy")
  securityDepositAccounts SecurityDepositAccount[] @relation("SecurityDepositTenant")
  accountingExports AccountingExport[] @relation("AccountingExportOwner")
  generatedAccountingExports AccountingExport[] @relation("AccountingExportGenerator")
  creditReportingRecords CreditReportingRecord[] @relation("CreditReportingTenant")
  financialInsightSnapshots FinancialInsightSnapshot[] @relation("FinancialInsightOwner")
  accountAccessRequests AccountAccessRequest[] @relation("AccountAccessRequests")
  reviewedAccountAccessRequests AccountAccessRequest[] @relation("ReviewedAccountAccessRequests")
  sessions UserSession[]
  createdClaimTokens ApplicationClaimToken[] @relation("CreatedApplicationClaimTokens")
  managedUnits Unit[] @relation("UnitPropertyManagers")
  maintainedUnits Unit[] @relation("UnitMaintenanceAssignees")
  caseworkUnits Unit[] @relation("UnitCaseworkers")
  landlordConnections ProfileConnection[] @relation("LandlordConnections")
  targetConnections ProfileConnection[] @relation("TargetConnections")

  notificationPreferences NotificationPreference[]
  notificationDeliveries NotificationDelivery[] @relation("NotificationRecipient")
  createdNotificationTemplates NotificationTemplate[] @relation("NotificationTemplateCreator")
  createdNotificationDeliveries NotificationDelivery[] @relation("NotificationCreator")
  createdTasks TaskItem[] @relation("TaskCreatedBy")
  assignedTasks TaskItem[] @relation("TaskAssignedTo")
  createdScheduleEvents ScheduleEvent[] @relation("ScheduleEventCreatedBy")
  assignedScheduleEvents ScheduleEvent[] @relation("ScheduleEventAssignedTo")
  scheduleParticipations ScheduleEventParticipant[]
  createdFormalNotices FormalNotice[] @relation("FormalNoticeCreatedBy")
  receivedFormalNotices FormalNotice[] @relation("FormalNoticeRecipient")
  ownedLeaseTemplates LeaseTemplate[] @relation("LeaseTemplateOwner")

  ownedScreeningPackages ScreeningPackage[] @relation("ScreeningPackageOwner")
  orderedScreenings ApplicantScreening[] @relation("ScreeningOrderedBy")
  reviewedScreenings ApplicantScreening[] @relation("ScreeningReviewedBy")
  ownedMaintenanceAssets MaintenanceAsset[] @relation("MaintenanceAssetOwner")
  createdAssetServiceRecords AssetServiceRecord[] @relation("AssetServiceRecordCreatedBy")
  managedInsurancePolicies InsurancePolicy[] @relation("InsurancePolicyOwner")
  trackedCertificationRecords CertificationRecord[] @relation("CertificationRecordOwner")
  integrationConnections IntegrationConnection[] @relation("IntegrationConnectionOwner")
  integrationEvents IntegrationEvent[] @relation("IntegrationEventActor")
  occupancies Occupancy[] @relation("OccupancyTenant")
  createdOccupancies Occupancy[] @relation("OccupancyCreatedBy")

  @@index([role, isActive])
  @@index([passwordResetTokenHash])
  @@index([lockedUntil])
}
model ProfileConnection {
  id             String           @id @default(cuid())
  landlordUserId String
  targetUserId   String
  unitId         String?
  scopeKey       String           @default("PORTFOLIO")
  assignedRole   ConnectionRole
  status         ConnectionStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  landlord User  @relation("LandlordConnections", fields: [landlordUserId], references: [id], onDelete: Cascade)
  target   User  @relation("TargetConnections", fields: [targetUserId], references: [id], onDelete: Cascade)
  unit     Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([landlordUserId, targetUserId, scopeKey, assignedRole])
  @@index([landlordUserId, status])
  @@index([targetUserId, status])
  @@index([unitId])
  @@index([scopeKey])
}

model Occupancy {
  id              String          @id @default(cuid())
  userId          String
  unitId          String
  applicationId   String?
  leasePacketId   String?
  status          OccupancyStatus @default(PENDING_MOVE_IN)
  relationship    ConnectionRole  @default(CONNECTED_RENTER)
  lifecycleEvent  RelationshipLifecycleEventType @default(TENANT_ACTIVATED)
  startedAt       DateTime        @default(now())
  moveInDate      DateTime?
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  moveOutDate     DateTime?
  endedAt         DateTime?
  notes           String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant      User         @relation("OccupancyTenant", fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  leasePacket LeasePacket? @relation(fields: [leasePacketId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("OccupancyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([applicationId, userId])
  @@index([userId, status])
  @@index([unitId, status])
  @@index([applicationId])
  @@index([leasePacketId])
  @@index([status, startedAt])
}

model AccountAccessRequest {
  id          String   @id @default(cuid())
  userId      String
  type        AccountAccessType
  status      AccountAccessRequestStatus @default(PENDING)
  organization String?
  reason      String?
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("AccountAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedAccountAccessRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([userId, type, status])
  @@index([reviewedById])
}


model UserSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  lastSeenAt  DateTime?
  ipAddress   String?
  userAgent   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ApplicationClaimToken {
  id            String   @id @default(cuid())
  applicationId String
  tokenHash     String   @unique
  email         String
  expiresAt     DateTime
  claimedAt     DateTime?
  claimedById   String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CreatedApplicationClaimTokens", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([email])
  @@index([expiresAt])
  @@index([claimedAt])
}


model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
