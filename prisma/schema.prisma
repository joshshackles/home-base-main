generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LANDLORD
  APPLICANT
  TENANT
  INSPECTOR
}

enum AccountAccessType {
  LANDLORD
  PROPERTY_MANAGER
  CASEWORKER
  INSPECTOR
  MAINTENANCE
  VENDOR
  ADMIN
}

enum AccountAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ConnectionRole {
  PROPERTY_MANAGER
  CASEWORKER
  INSPECTOR
  MAINTENANCE_STAFF
  PREFERRED_VENDOR
  CONNECTED_RENTER
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum UnitStatus {
  AVAILABLE
  PENDING
  OCCUPIED
  UNAVAILABLE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  APPLICATION_STARTED
  CLOSED
}

enum ApplicationStatus {
  STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUALLY
}

enum HouseholdRelationship {
  SELF
  SPOUSE
  CHILD
  OTHER_ADULT
  OTHER
}

enum DocumentCategory {
  PHOTO_ID
  PROOF_OF_INCOME
  LEASE
  INSPECTION
  UTILITY_ALLOWANCE
  RFTA
  APPLICATION_PACKET
  LANDLORD_DOCUMENT
  TENANT_DOCUMENT
  OTHER
}

enum DocumentStatus {
  REQUESTED
  UPLOADED
  REVIEWED
  REJECTED
  ACCEPTED
}

enum DocumentVisibility {
  INTERNAL
  APPLICANT
  LANDLORD
  SHARED
}

enum DocumentRequestStatus {
  REQUESTED
  SUBMITTED
  ACCEPTED
  REJECTED
  WAIVED
}

enum LeasePacketStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SENT_FOR_SIGNATURE
  COMPLETED
  VOIDED
}

enum SignatureRole {
  TENANT
  LANDLORD
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  VOIDED
  EXPIRED
}

enum SignatureNotificationType {
  INITIAL
  REMINDER
  EXPIRATION_WARNING
  EXPIRED
}

enum SignatureNotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  PASSED
  FAILED
  NEEDS_REINSPECTION
  CANCELLED
}

enum InspectionChecklistStatus {
  PENDING
  PASS
  FAIL
  NA
}


enum MaintenanceRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_TENANT
  WAITING_ON_VENDOR
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageThreadType {
  GENERAL
  APPLICATION
  LEASE
  MAINTENANCE
}

enum MessageThreadStatus {
  OPEN
  WAITING_ON_STAFF
  WAITING_ON_APPLICANT
  CLOSED
}


enum LedgerEntryType {
  CHARGE
  PAYMENT
  CREDIT
  ADJUSTMENT
}

enum LedgerEntryStatus {
  POSTED
  PENDING
  VOIDED
}

enum PaymentMethod {
  CASH
  CHECK
  MONEY_ORDER
  CARD
  ACH
  OTHER
}

enum RecurringChargeFrequency {
  MONTHLY
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum PaymentPlanInstallmentStatus {
  DUE
  PAID
  MISSED
  WAIVED
}

enum UtilityAccountStatus {
  SETUP_NEEDED
  ACTIVE
  PAUSED
  CANCELLED
}

enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  OTHER
}

enum TenantPaymentStatus {
  PLANNED
  SUBMITTED
  CONFIRMED
  CANCELLED
}

enum TenantPaymentMethod {
  CASH
  CHECK
  MONEY_ORDER
  CARD
  ACH
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(APPLICANT)
  isActive     Boolean  @default(true)
  forcePasswordReset Boolean @default(false)
  passwordChangedAt DateTime?
  lastLoginAt DateTime?
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  applicantProfile ApplicantProfile?
  applications Application[]
  uploadedDocuments Document[] @relation("UploadedDocuments")
  reviewedDocuments Document[] @relation("ReviewedDocuments")
  requestedDocuments DocumentRequest[] @relation("RequestedDocuments")
  signatureRequests SignatureRequest[]
  signatureNotifications SignatureNotification[]
  assignedInspections Inspection[] @relation("AssignedInspections")
  requestedMaintenanceRequests MaintenanceRequest[] @relation("RequestedMaintenanceRequests")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("AssignedMaintenanceRequests")
  createdMessageThreads MessageThread[] @relation("CreatedMessageThreads")
  sentMessages Message[] @relation("SentMessages")
  createdLedgerEntries LedgerEntry[] @relation("CreatedLedgerEntries")
  tenantLedgerEntries LedgerEntry[] @relation("TenantLedgerEntries")
  recurringChargeSchedules RecurringChargeSchedule[] @relation("TenantRecurringChargeSchedules")
  createdRecurringChargeSchedules RecurringChargeSchedule[] @relation("CreatedRecurringChargeSchedules")
  paymentPlans PaymentPlan[] @relation("TenantPaymentPlans")
  createdPaymentPlans PaymentPlan[] @relation("CreatedPaymentPlans")
  currentTenantUnits Unit[] @relation("CurrentTenantUnits")
  favoriteRentals FavoriteRental[]
  utilityAccounts UtilityAccount[]
  payrollReminders PayrollReminder[]
  tenantPayments TenantPayment[]
  accountAccessRequests AccountAccessRequest[] @relation("AccountAccessRequests")
  reviewedAccountAccessRequests AccountAccessRequest[] @relation("ReviewedAccountAccessRequests")
  sessions UserSession[]
  createdClaimTokens ApplicationClaimToken[] @relation("CreatedApplicationClaimTokens")
  managedUnits Unit[] @relation("UnitPropertyManagers")
  maintainedUnits Unit[] @relation("UnitMaintenanceAssignees")
  caseworkUnits Unit[] @relation("UnitCaseworkers")
  landlordConnections ProfileConnection[] @relation("LandlordConnections")
  targetConnections ProfileConnection[] @relation("TargetConnections")

  @@index([role, isActive])
  @@index([passwordResetTokenHash])
  @@index([lockedUntil])
}

model ProfileConnection {
  id             String           @id @default(cuid())
  landlordUserId String
  targetUserId   String
  unitId         String?
  scopeKey       String           @default("PORTFOLIO")
  assignedRole   ConnectionRole
  status         ConnectionStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  landlord User  @relation("LandlordConnections", fields: [landlordUserId], references: [id], onDelete: Cascade)
  target   User  @relation("TargetConnections", fields: [targetUserId], references: [id], onDelete: Cascade)
  unit     Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([landlordUserId, targetUserId, scopeKey, assignedRole])
  @@index([landlordUserId, status])
  @@index([targetUserId, status])
  @@index([unitId])
  @@index([scopeKey])
}

model AccountAccessRequest {
  id          String   @id @default(cuid())
  userId      String
  type        AccountAccessType
  status      AccountAccessRequestStatus @default(PENDING)
  organization String?
  reason      String?
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("AccountAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedAccountAccessRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([userId, type, status])
  @@index([reviewedById])
}


model UserSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  lastSeenAt  DateTime?
  ipAddress   String?
  userAgent   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ApplicationClaimToken {
  id            String   @id @default(cuid())
  applicationId String
  tokenHash     String   @unique
  email         String
  expiresAt     DateTime
  claimedAt     DateTime?
  claimedById   String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CreatedApplicationClaimTokens", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([email])
  @@index([expiresAt])
  @@index([claimedAt])
}


model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}


model Property {
  id          String   @id @default(cuid())
  name        String
  addressLine String
  city        String
  state       String
  zip         String
  description String?
  ownerId     String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id])
  units Unit[]
  documents Document[]

  @@index([city, state])
  @@index([ownerId])
}

model Unit {
  id              String     @id @default(cuid())
  propertyId      String
  unitNumber      String
  tenantUserId    String?
  currentApplicationId String?
  propertyManagerUserId String?
  maintenanceUserId String?
  caseworkerUserId String?
  bedrooms        Int
  bathrooms       Float
  rentAmount      Int
  deposit         Int?
  squareFeet      Int?
  voucherFriendly Boolean    @default(false)
  utilitiesNote   String?
  accessibility   String?
  petPolicy       String?
  schoolDistrict  String?
  neighborhood    String?
  nearbyFeatures  String?
  yearBuilt       Int?
  roofAgeYears    Int?
  averageUtilityBill Int?
  parkingInfo     String?
  laundryInfo     String?
  appliancesIncluded String?
  flooringInfo    String?
  yardInfo        String?
  smokingPolicy   String?
  leaseTermsNote  String?
  moveInFeesNote  String?
  rentDueDay      Int?
  lateFeePolicy   String?
  previousTenantNotes String?
  status          UnitStatus @default(AVAILABLE)
  description     String?
  clientNotes     String?
  importantContacts String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantUser   User?         @relation("CurrentTenantUnits", fields: [tenantUserId], references: [id], onDelete: SetNull)
  currentApplication Application? @relation("CurrentTenantApplication", fields: [currentApplicationId], references: [id], onDelete: SetNull)
  propertyManager User?      @relation("UnitPropertyManagers", fields: [propertyManagerUserId], references: [id], onDelete: SetNull)
  maintenanceUser User?      @relation("UnitMaintenanceAssignees", fields: [maintenanceUserId], references: [id], onDelete: SetNull)
  caseworker User?           @relation("UnitCaseworkers", fields: [caseworkerUserId], references: [id], onDelete: SetNull)
  leads        Lead[]
  applications Application[]
  favoriteRentals FavoriteRental[]
  utilityAccounts UtilityAccount[]
  tenantPayments TenantPayment[]
  inspections  Inspection[]
  maintenanceRequests MaintenanceRequest[]
  documents    Document[]
  photos       UnitPhoto[]
  ledgerEntries LedgerEntry[]
  recurringChargeSchedules RecurringChargeSchedule[]
  paymentPlans PaymentPlan[]
  profileConnections ProfileConnection[]

  @@index([propertyId])
  @@index([tenantUserId])
  @@index([currentApplicationId])
  @@index([propertyManagerUserId])
  @@index([maintenanceUserId])
  @@index([caseworkerUserId])
  @@index([status])
  @@unique([propertyId, unitNumber])
}

model UnitPhoto {
  id           String   @id @default(cuid())
  unitId       String
  title        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  sortOrder    Int      @default(0)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([unitId, isFeatured])
  @@index([unitId, sortOrder])
}


model Lead {
  id        String     @id @default(cuid())
  unitId    String
  name      String
  email     String
  phone     String?
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  notes       LeadNote[]
  application Application?

  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  note      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model Application {
  id              String            @id @default(cuid())
  leadId          String?           @unique
  unitId          String
  applicantUserId String?
  applicantName   String
  applicantEmail String
  applicantPhone String?
  status         ApplicationStatus @default(STARTED)
  summary        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applicantUser User?             @relation(fields: [applicantUserId], references: [id], onDelete: SetNull)
  notes         ApplicationNote[]
  documents     Document[]
  documentRequests DocumentRequest[]
  leasePackets LeasePacket[]
  inspections Inspection[]
  maintenanceRequests MaintenanceRequest[]
  messageThreads MessageThread[]
  ledgerEntries LedgerEntry[]
  recurringChargeSchedules RecurringChargeSchedule[]
  paymentPlans PaymentPlan[]
  claimTokens ApplicationClaimToken[]
  currentTenantUnits Unit[] @relation("CurrentTenantApplication")
  utilityAccounts UtilityAccount[]
  tenantPayments TenantPayment[]

  @@index([unitId])
  @@index([applicantUserId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  note          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}


model ApplicantProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  legalName       String
  preferredName   String?
  phone           String?
  currentAddress  String?
  city            String?
  state           String?
  zip             String?
  householdSize   Int?
  rentalHistory   String?
  desiredBedrooms Int?
  desiredBathrooms Float?
  maxRent          Int?
  desiredMoveInDate DateTime?
  voucherHolder    Boolean @default(false)
  pets             String?
  accessibilityNeeds String?
  landlordReferences String?
  employmentSummary String?
  renterBio        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdMembers HouseholdMember[]
  incomeSources    IncomeSource[]
}

model HouseholdMember {
  id          String                @id @default(cuid())
  profileId   String
  name        String
  relationship HouseholdRelationship @default(OTHER)
  age         Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  profile ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model IncomeSource {
  id          String          @id @default(cuid())
  profileId   String
  sourceName  String
  amount      Int
  frequency   IncomeFrequency @default(MONTHLY)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  profile ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model FavoriteRental {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
  @@index([createdAt])
}

model UtilityAccount {
  id            String               @id @default(cuid())
  userId        String
  unitId        String?
  applicationId String?
  providerName  String
  serviceType   String
  accountNumber String?
  status        UtilityAccountStatus @default(SETUP_NEEDED)
  dueDayOfMonth Int?
  averageAmount Int?
  autopayEnabled Boolean             @default(false)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([unitId])
  @@index([applicationId])
  @@index([status])
  @@index([dueDayOfMonth])
}

model PayrollReminder {
  id          String           @id @default(cuid())
  userId      String
  employerName String
  frequency   PayrollFrequency @default(BIWEEKLY)
  nextPayDate DateTime?
  typicalAmount Int?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextPayDate])
}

model TenantPayment {
  id            String              @id @default(cuid())
  userId        String
  unitId        String
  applicationId String?
  ledgerEntryId String?
  amount        Int
  method        TenantPaymentMethod @default(ACH)
  status        TenantPaymentStatus @default(PLANNED)
  dueDate       DateTime?
  submittedAt   DateTime?
  confirmation  String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([unitId])
  @@index([applicationId])
  @@index([ledgerEntryId])
  @@index([status])
  @@index([dueDate])
}


model Document {
  id            String             @id @default(cuid())
  title         String
  category      DocumentCategory   @default(OTHER)
  status        DocumentStatus     @default(UPLOADED)
  visibility    DocumentVisibility @default(INTERNAL)
  fileName      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  sha256Hash    String?
  notes         String?
  applicationId String?
  propertyId    String?
  unitId        String?
  leasePacketId String?
  uploadedById  String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leasePacket LeasePacket? @relation(fields: [leasePacketId], references: [id], onDelete: SetNull)
  uploadedBy  User?        @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("ReviewedDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)
  fulfilledRequests DocumentRequest[] @relation("FulfilledDocumentRequests")

  @@index([applicationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([sha256Hash])
}

model StoredDocument {
  key          String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  bytes        Bytes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Inspection {
  id              String           @id @default(cuid())
  unitId          String
  applicationId   String?
  assignedToId    String?
  status          InspectionStatus @default(SCHEDULED)
  scheduledFor    DateTime?
  completedAt     DateTime?
  inspectorName   String?
  resultSummary   String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation("AssignedInspections", fields: [assignedToId], references: [id], onDelete: SetNull)
  checklistItems InspectionChecklistItem[]

  @@index([unitId])
  @@index([applicationId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledFor])
}

model InspectionChecklistItem {
  id           String                    @id @default(cuid())
  inspectionId String
  label        String
  status       InspectionChecklistStatus @default(PENDING)
  notes        String?
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([status])
  @@index([sortOrder])
}

model MaintenanceRequest {
  id            String                   @id @default(cuid())
  unitId        String?
  applicationId String?
  requesterId   String
  assignedToId  String?
  status        MaintenanceRequestStatus @default(NEW)
  priority      MaintenancePriority      @default(NORMAL)
  subject       String
  description   String
  accessNotes   String?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  requester   User         @relation("RequestedMaintenanceRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedTo  User?        @relation("AssignedMaintenanceRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  messageThreads MessageThread[]

  @@index([unitId])
  @@index([applicationId])
  @@index([requesterId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model MessageThread {
  id                   String              @id @default(cuid())
  type                 MessageThreadType   @default(GENERAL)
  status               MessageThreadStatus @default(OPEN)
  subject              String
  applicationId         String?
  maintenanceRequestId String?
  createdById          String
  lastMessageAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  application        Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("CreatedMessageThreads", fields: [createdById], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([type])
  @@index([status])
  @@index([applicationId])
  @@index([maintenanceRequestId])
  @@index([createdById])
  @@index([lastMessageAt])
}

model Message {
  id          String   @id @default(cuid())
  threadId    String
  senderId    String
  body        String
  isInternal  Boolean  @default(false)
  readByStaffAt DateTime?
  readByApplicantAt DateTime?
  createdAt   DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isInternal])
}

model LeaseTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leasePackets LeasePacket[]

  @@index([isActive])
}

model LeasePacket {
  id              String            @id @default(cuid())
  applicationId   String
  templateId      String
  status          LeasePacketStatus @default(DRAFT)
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  monthlyRent     Int
  securityDeposit Int?
  terms           String?
  notes           String?
  approvedAt      DateTime?
  sentForSignatureAt DateTime?
  completedAt     DateTime?
  voidedAt        DateTime?
  lockedAt        DateTime?
  finalDocumentId String?
  finalPdfGeneratedAt DateTime?
  reissuedFromId  String?
  reissueReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  template    LeaseTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  packetNotes LeaseNote[]
  documents   Document[]
  signatureRequests SignatureRequest[]

  @@index([applicationId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model SignatureRequest {
  id            String          @id @default(cuid())
  leasePacketId String
  signerRole    SignatureRole
  signerUserId  String?
  signerName    String
  signerEmail   String
  status        SignatureStatus @default(PENDING)
  signatureText String?
  signedAt      DateTime?
  declinedAt    DateTime?
  ipAddress     String?
  userAgent     String?
  electronicConsentAccepted Boolean @default(false)
  electronicConsentText     String?
  electronicConsentAcceptedAt DateTime?
  documentTextHash          String?
  signatureEvidenceHash     String?
  finalPdfHash              String?
  expiresAt     DateTime?
  reminderCount Int             @default(0)
  lastReminderAt DateTime?
  lastNotificationAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  leasePacket LeasePacket @relation(fields: [leasePacketId], references: [id], onDelete: Cascade)
  signer      User?       @relation(fields: [signerUserId], references: [id], onDelete: SetNull)
  notifications SignatureNotification[]

  @@index([leasePacketId])
  @@index([signerUserId])
  @@index([signerEmail])
  @@index([signerRole])
  @@index([status])
  @@index([expiresAt])
  @@index([documentTextHash])
  @@index([signatureEvidenceHash])
}

model SignatureNotification {
  id                 String                      @id @default(cuid())
  signatureRequestId String
  recipientEmail     String
  recipientName      String?
  type               SignatureNotificationType   @default(INITIAL)
  status             SignatureNotificationStatus @default(QUEUED)
  subject            String
  body               String
  sentAt             DateTime?
  failedAt           DateTime?
  failureReason      String?
  attemptCount       Int                         @default(0)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?
  provider           String?
  providerMessageId  String?
  createdById        String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([signatureRequestId])
  @@index([recipientEmail])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([status, nextAttemptAt])
}

model LeaseNote {
  id            String   @id @default(cuid())
  leasePacketId String
  note          String
  createdAt     DateTime @default(now())

  leasePacket LeasePacket @relation(fields: [leasePacketId], references: [id], onDelete: Cascade)

  @@index([leasePacketId])
  @@index([createdAt])
}

model DocumentRequest {
  id                  String                @id @default(cuid())
  applicationId        String
  title               String
  category            DocumentCategory      @default(OTHER)
  status              DocumentRequestStatus @default(REQUESTED)
  visibility          DocumentVisibility    @default(APPLICANT)
  instructions         String?
  dueDate             DateTime?
  requestedById       String?
  fulfilledDocumentId String?
  reviewNotes         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy       User?       @relation("RequestedDocuments", fields: [requestedById], references: [id], onDelete: SetNull)
  fulfilledDocument Document?   @relation("FulfilledDocumentRequests", fields: [fulfilledDocumentId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@index([category])
  @@index([dueDate])
  @@index([fulfilledDocumentId])
}


model RecurringChargeSchedule {
  id                    String                    @id @default(cuid())
  applicationId         String?
  unitId                String
  tenantUserId          String?
  name                  String
  description           String
  frequency             RecurringChargeFrequency  @default(MONTHLY)
  amount                Int
  tenantPortionAmount   Int?
  subsidyPortionAmount  Int?
  dayOfMonth            Int                       @default(1)
  startDate             DateTime
  endDate               DateTime?
  nextRunDate           DateTime
  lastRunDate           DateTime?
  isActive              Boolean                   @default(true)
  createdById           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantUser  User?        @relation("TenantRecurringChargeSchedules", fields: [tenantUserId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CreatedRecurringChargeSchedules", fields: [createdById], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[] @relation("GeneratedRecurringCharges")

  @@index([applicationId])
  @@index([unitId])
  @@index([tenantUserId])
  @@index([isActive])
  @@index([nextRunDate])
}

model PaymentPlan {
  id                  String             @id @default(cuid())
  applicationId       String?
  unitId              String
  tenantUserId        String?
  name                String
  totalAmount         Int
  installmentAmount   Int
  dueDayOfMonth       Int                @default(1)
  startDate           DateTime
  endDate             DateTime?
  status              PaymentPlanStatus  @default(ACTIVE)
  notes               String?
  createdById         String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  defaultedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  application  Application?              @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  unit         Unit                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantUser   User?                     @relation("TenantPaymentPlans", fields: [tenantUserId], references: [id], onDelete: SetNull)
  createdBy    User?                     @relation("CreatedPaymentPlans", fields: [createdById], references: [id], onDelete: SetNull)
  installments PaymentPlanInstallment[]

  @@index([applicationId])
  @@index([unitId])
  @@index([tenantUserId])
  @@index([status])
  @@index([startDate])
}

model PaymentPlanInstallment {
  id                  String                         @id @default(cuid())
  paymentPlanId       String
  dueDate             DateTime
  amount              Int
  status              PaymentPlanInstallmentStatus   @default(DUE)
  paidAt              DateTime?
  linkedLedgerEntryId String?
  notes               String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId])
  @@index([status])
  @@index([dueDate])
  @@index([linkedLedgerEntryId])
}

model LedgerEntry {
  id              String            @id @default(cuid())
  applicationId   String?
  unitId          String
  tenantUserId    String?
  type            LedgerEntryType
  status          LedgerEntryStatus @default(POSTED)
  paymentMethod   PaymentMethod?
  amount          Int
  description     String
  memo            String?
  dueDate         DateTime?
  paidAt          DateTime?
  postedAt        DateTime          @default(now())
  voidedAt        DateTime?
  voidReason      String?
  createdById     String?
  generatedFromScheduleId String?
  generatedForPeriod String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantUser  User?        @relation("TenantLedgerEntries", fields: [tenantUserId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CreatedLedgerEntries", fields: [createdById], references: [id], onDelete: SetNull)
  generatedFromSchedule RecurringChargeSchedule? @relation("GeneratedRecurringCharges", fields: [generatedFromScheduleId], references: [id], onDelete: SetNull)
  tenantPayments TenantPayment[]

  @@index([applicationId])
  @@index([unitId])
  @@index([tenantUserId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([postedAt])
  @@index([generatedFromScheduleId])
  @@unique([generatedFromScheduleId, generatedForPeriod])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_LINK_CREATED
  SIGNATURE_REQUESTED
  SIGNATURE_REMINDER_QUEUED
  SIGNATURE_EXPIRED
  SIGNATURE_EXPIRATION_EXTENDED
  SIGNATURE_COMPLETED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  FINAL_LEASE_GENERATED
  LEASE_REISSUED
  MAINTENANCE_REQUEST_CREATED
  MESSAGE_SENT
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
  STATUS_CHANGE
  NOTE
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  LINK
  CONVERT
  SIGN
  SEND
  REMIND
  EXPIRE
  COMPLETE
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorRole   UserRole?
  action      AuditAction
  entityType  String
  entityId    String?
  message     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}


model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?
  email     String?
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([type])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}
