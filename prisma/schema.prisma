model ScheduleEvent {
  id              String                  @id @default(cuid())
  title           String
  description     String?
  type            ScheduleEventType       @default(GENERAL)
  status          ScheduleEventStatus     @default(SCHEDULED)
  visibility      ScheduleEventVisibility @default(PARTICIPANTS)
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean                 @default(false)
  location        String?
  meetingUrl      String?
  reminderMinutes Int?                    @default(60)
  propertyId      String?
  unitId          String?
  taskItemId      String?
  createdById     String?
  assignedToId    String?
