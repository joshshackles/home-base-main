  paymentEvents PaymentEvent[]
  autoPayEnrollments AutoPayEnrollment[]
  paymentRetryAttempts PaymentRetryAttempt[]
  financialAdjustments FinancialAdjustment[]
  ownerStatementItems OwnerStatementItem[]
  paymentDisputes PaymentDispute[]
  vendorPayouts VendorPayout[]
  securityDepositAccounts SecurityDepositAccount[]
  creditReportingRecords CreditReportingRecord[]
  createdById     String?
  generatedFromScheduleId String?
  generatedForPeriod String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantUser  User?        @relation("TenantLedgerEntries", fields: [tenantUserId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CreatedLedgerEntries", fields: [createdById], references: [id], onDelete: SetNull)
  generatedFromSchedule RecurringChargeSchedule? @relation("GeneratedRecurringCharges", fields: [generatedFromScheduleId], references: [id], onDelete: SetNull)
  tenantPayments TenantPayment[]

  @@index([applicationId])
  @@index([unitId])
  @@index([tenantUserId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([postedAt])
  @@index([stripePaymentStatus])
  @@index([generatedFromScheduleId])
  @@unique([generatedFromScheduleId, generatedForPeriod])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_LINK_CREATED
  SIGNATURE_REQUESTED
  SIGNATURE_REMINDER_QUEUED
  SIGNATURE_EXPIRED
  SIGNATURE_EXPIRATION_EXTENDED
  SIGNATURE_COMPLETED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  FINAL_LEASE_GENERATED
  LEASE_REISSUED
  MAINTENANCE_REQUEST_CREATED
  MESSAGE_SENT
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
  STATUS_CHANGE
  NOTE
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  LINK
  CONVERT
  SIGN
  SEND
  REMIND
  EXPIRE
  COMPLETE
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorRole   UserRole?
  action      AuditAction
  entityType  String
  entityId    String?
  message     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}


model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?
  email     String?
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([type])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}
