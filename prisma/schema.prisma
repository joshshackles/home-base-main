  property      Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit          Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  leasePacket   LeasePacket? @relation(fields: [leasePacketId], references: [id], onDelete: SetNull)
  recipientUser User?        @relation("FormalNoticeRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("FormalNoticeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([audience, status])
  @@index([propertyId])
  @@index([unitId])
  @@index([applicationId])
  @@index([leasePacketId])
  @@index([recipientUserId, status])
  @@index([recipientEmail])
  @@index([createdById])
  @@index([dueAt])
  @@index([sentAt])
  @@index([createdAt])
}

