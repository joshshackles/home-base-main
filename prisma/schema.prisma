  notices FormalNotice[]

  maintenanceAssets MaintenanceAsset[]
  insurancePolicies InsurancePolicy[]
  certificationRecords CertificationRecord[]
  complianceInspectionRequirements ComplianceInspectionRequirement[]

  @@index([city, state])
  @@index([ownerId])
}
