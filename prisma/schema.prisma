generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LANDLORD
  APPLICANT
  TENANT
  INSPECTOR
}

enum AccountAccessType {
  LANDLORD
  PROPERTY_MANAGER
  CASEWORKER
  INSPECTOR
  MAINTENANCE
  VENDOR
  ADMIN
}

enum AccountAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ConnectionRole {
  PROPERTY_MANAGER
  CASEWORKER
  INSPECTOR
  MAINTENANCE_STAFF
  PREFERRED_VENDOR
  CONNECTED_RENTER
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum UnitStatus {
  AVAILABLE
  PENDING
  OCCUPIED
  UNAVAILABLE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  APPLICATION_STARTED
  CLOSED
}

enum ApplicationStatus {
  STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUALLY
}

enum HouseholdRelationship {
  SELF
  SPOUSE
  CHILD
  OTHER_ADULT
  OTHER
}

enum DocumentCategory {
  PHOTO_ID
  PROOF_OF_INCOME
  LEASE
  INSPECTION
  UTILITY_ALLOWANCE
  RFTA
  APPLICATION_PACKET
  LANDLORD_DOCUMENT
  TENANT_DOCUMENT
  OTHER
}

enum DocumentStatus {
  REQUESTED
  UPLOADED
  REVIEWED
  REJECTED
  ACCEPTED
}

enum DocumentVisibility {
  INTERNAL
  APPLICANT
  LANDLORD
  SHARED
}

enum DocumentRequestStatus {
  REQUESTED
  SUBMITTED
  ACCEPTED
  REJECTED
  WAIVED
}

enum LeasePacketStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SENT_FOR_SIGNATURE
  COMPLETED
  VOIDED
}

enum SignatureRole {
  TENANT
  LANDLORD
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  VOIDED
  EXPIRED
}

enum SignatureNotificationType {
  INITIAL
  REMINDER
  EXPIRATION_WARNING
  EXPIRED
}

enum SignatureNotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  PASSED
  FAILED
  NEEDS_REINSPECTION
  CANCELLED
}

enum InspectionChecklistStatus {
  PENDING
  PASS
  FAIL
  NA
}


enum MaintenanceRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_TENANT
  WAITING_ON_VENDOR
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageThreadType {
  GENERAL
  APPLICATION
  LEASE
  MAINTENANCE
}

enum MessageThreadStatus {
  OPEN
  WAITING_ON_STAFF
  WAITING_ON_APPLICANT
  CLOSED
}


enum LedgerEntryType {
  CHARGE
  PAYMENT
  CREDIT
  ADJUSTMENT
}

enum LedgerEntryStatus {
  POSTED
  PENDING
  VOIDED
}

enum PaymentMethod {
  CASH
  CHECK
  MONEY_ORDER
  CARD
  ACH
  OTHER
}

enum RecurringChargeFrequency {
  MONTHLY
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum PaymentPlanInstallmentStatus {
  DUE
  PAID
  MISSED
  WAIVED
}

enum UtilityAccountStatus {
  SETUP_NEEDED
  ACTIVE
  PAUSED
  CANCELLED
}

enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  OTHER
}

enum TenantPaymentStatus {
  PLANNED
  SUBMITTED
  CONFIRMED
  CANCELLED
}

enum TenantPaymentMethod {
  CASH
  CHECK
  MONEY_ORDER
  CARD
  ACH
  OTHER
}


enum StoredPaymentMethodType {
  US_BANK_ACCOUNT
  CARD
  OTHER
}

enum PaymentMethodVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum ScheduledPaymentStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum LateFeeMode {
  NONE
  FLAT
  PERCENT
  DAILY_FLAT
}

enum PaymentEventType {
  METHOD_ADDED
  METHOD_VERIFIED
  SCHEDULE_CREATED
  SCHEDULE_CANCELLED
  PAYMENT_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  PAYMENT_RETRY_SCHEDULED
  PAYMENT_RETRY_SUCCEEDED
  PAYMENT_RETRY_FAILED
  AUTOPAY_ENABLED
  AUTOPAY_PAUSED
  AUTOPAY_CANCELLED
  RENT_GENERATED
  STATEMENT_GENERATED
  FINANCIAL_ADJUSTMENT_CREATED
  REFUND_REQUESTED
  LATE_FEE_APPLIED
  RENT_ADJUSTED
}

enum AutoPayEnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentRetryAttemptStatus {
  SCHEDULED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FinancialAdjustmentType {
  CREDIT
  WAIVER
  REFUND
  RENT_ADJUSTMENT
  MANUAL_CHARGE
}

enum OwnerStatementStatus {
  DRAFT
  FINALIZED
  EXPORTED
}


enum PaymentDisputeStatus {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

enum VendorPayoutStatus {
  DRAFT
  APPROVAL_REQUIRED
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum SecurityDepositStatus {
  DUE
  HELD
  PARTIALLY_RELEASED
  RELEASED
  DISPUTED
}

enum AccountingExportType {
  QUICKBOOKS_CSV
  XERO_CSV
  OWNER_STATEMENT_CSV
  PORTFOLIO_SUMMARY_CSV
}

enum AccountingExportStatus {
  GENERATED
  DOWNLOADED
  ARCHIVED
}

enum CreditReportingStatus {
  NOT_ELIGIBLE
  READY
  EXPORTED
  SUPPRESSED
}

enum FinancialRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FinancialPermission {
  VIEW_FINANCIALS
  COLLECT_PAYMENTS
  REFUND_PAYMENTS
  WAIVE_FEES
  EDIT_RENT
  EXPORT_STATEMENTS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(APPLICANT)
  isActive     Boolean  @default(true)
  forcePasswordReset Boolean @default(false)
  passwordChangedAt DateTime?
  lastLoginAt DateTime?
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  stripeConnectAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeOnboardingComplete Boolean @default(false)
  stripeConnectLastSyncedAt DateTime?
  stripeCustomerId String? @unique
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  applicantProfile ApplicantProfile?
  applications Application[]
  uploadedDocuments Document[] @relation("UploadedDocuments")
  reviewedDocuments Document[] @relation("ReviewedDocuments")
  requestedDocuments DocumentRequest[] @relation("RequestedDocuments")
  signatureRequests SignatureRequest[]
  signatureNotifications SignatureNotification[]
  assignedInspections Inspection[] @relation("AssignedInspections")
  requestedMaintenanceRequests MaintenanceRequest[] @relation("RequestedMaintenanceRequests")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("AssignedMaintenanceRequests")
  createdMessageThreads MessageThread[] @relation("CreatedMessageThreads")
  sentMessages Message[] @relation("SentMessages")
  createdLedgerEntries LedgerEntry[] @relation("CreatedLedgerEntries")
  tenantLedgerEntries LedgerEntry[] @relation("TenantLedgerEntries")
  recurringChargeSchedules RecurringChargeSchedule[] @relation("TenantRecurringChargeSchedules")
  createdRecurringChargeSchedules RecurringChargeSchedule[] @relation("CreatedRecurringChargeSchedules")
  paymentPlans PaymentPlan[] @relation("TenantPaymentPlans")
  createdPaymentPlans PaymentPlan[] @relation("CreatedPaymentPlans")
  currentTenantUnits Unit[] @relation("CurrentTenantUnits")
  favoriteRentals FavoriteRental[]
  utilityAccounts UtilityAccount[]
  payrollReminders PayrollReminder[]
  tenantPayments TenantPayment[]
  renterPaymentMethods RenterPaymentMethod[]
  scheduledPayments ScheduledPayment[]
  paymentEvents PaymentEvent[]
  autoPayEnrollments AutoPayEnrollment[]
  paymentRetryAttempts PaymentRetryAttempt[]
  financialAdjustments FinancialAdjustment[] @relation("FinancialAdjustmentActor")
  ownerStatements OwnerStatement[] @relation("OwnerStatements")
  generatedOwnerStatements OwnerStatement[] @relation("GeneratedOwnerStatements")
  paymentDisputes PaymentDispute[] @relation("DisputeOwner")
  vendorPayouts VendorPayout[] @relation("VendorPayoutOwner")
  vendorPayoutVendorRecords VendorPayout[] @relation("VendorPayoutVendor")
  approvedVendorPayouts VendorPayout[] @relation("VendorPayoutApprover")
  securityDepositAccounts SecurityDepositAccount[] @relation("SecurityDepositTenant")
  accountingExports AccountingExport[] @relation("AccountingExportOwner")
  generatedAccountingExports AccountingExport[] @relation("AccountingExportGenerator")
  creditReportingRecords CreditReportingRecord[] @relation("CreditReportingTenant")
  financialInsightSnapshots FinancialInsightSnapshot[] @relation("FinancialInsightOwner")
  accountAccessRequests AccountAccessRequest[] @relation("AccountAccessRequests")
  reviewedAccountAccessRequests AccountAccessRequest[] @relation("ReviewedAccountAccessRequests")
  sessions UserSession[]
  createdClaimTokens ApplicationClaimToken[] @relation("CreatedApplicationClaimTokens")
  managedUnits Unit[] @relation("UnitPropertyManagers")
  maintainedUnits Unit[] @relation("UnitMaintenanceAssignees")
  caseworkUnits Unit[] @relation("UnitCaseworkers")
  landlordConnections ProfileConnection[] @relation("LandlordConnections")
  targetConnections ProfileConnection[] @relation("TargetConnections")

  @@index([role, isActive])
  @@index([passwordResetTokenHash])
  @@index([lockedUntil])
}

model ProfileConnection {
  id             String           @id @default(cuid())
  landlordUserId String
  targetUserId   String
  unitId         String?
  scopeKey       String           @default("PORTFOLIO")
  assignedRole   ConnectionRole
  status         ConnectionStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  landlord User  @relation("LandlordConnections", fields: [landlordUserId], references: [id], onDelete: Cascade)
  target   User  @relation("TargetConnections", fields: [targetUserId], references: [id], onDelete: Cascade)
  unit     Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([landlordUserId, targetUserId, scopeKey, assignedRole])
  @@index([landlordUserId, status])
  @@index([targetUserId, status])
  @@index([unitId])
  @@index([scopeKey])
}

model AccountAccessRequest {
  id          String   @id @default(cuid())
  userId      String
  type        AccountAccessType
  status      AccountAccessRequestStatus @default(PENDING)
  organization String?
  reason      String?
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("AccountAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedAccountAccessRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([userId, type, status])
  @@index([reviewedById])
}


model UserSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  lastSeenAt  DateTime?
  ipAddress   String?
  userAgent   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ApplicationClaimToken {
  id            String   @id @default(cuid())
  applicationId String
  tokenHash     String   @unique
  email         String
  expiresAt     DateTime
  claimedAt     DateTime?
  claimedById   String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CreatedApplicationClaimTokens", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([email])
  @@index([expiresAt])
  @@index([claimedAt])
}


model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}


model Property {
  id          String   @id @default(cuid())
  name        String
  addressLine String
  city        String
  state       String
  zip         String
  description String?
  ownerId     String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id])
  units Unit[]
  documents Document[]

  @@index([city, state])
  @@index([ownerId])
}

model Unit {
  id              String     @id @default(cuid())
  propertyId      String
  unitNumber      String
  tenantUserId    String?
  currentApplicationId String?
  propertyManagerUserId String?
  maintenanceUserId String?
  caseworkerUserId String?
  bedrooms        Int
  bathrooms       Float
  rentAmount      Int
  deposit         Int?
  squareFeet      Int?
  voucherFriendly Boolean    @default(false)
  utilitiesNote   String?
  accessibility   String?
  petPolicy       String?
  schoolDistrict  String?
  neighborhood    String?
  nearbyFeatures  String?
  yearBuilt       Int?
  roofAgeYears    Int?
  averageUtilityBill Int?
  parkingInfo     String?
  laundryInfo     String?
  appliancesIncluded String?
  flooringInfo    String?
  yardInfo        String?
  smokingPolicy   String?
  leaseTermsNote  String?
  moveInFeesNote  String?
  rentDueDay      Int?
  lateFeePolicy   String?
  previousTenantNotes String?
  status          UnitStatus @default(AVAILABLE)
  description     String?
  clientNotes     String?
  importantContacts String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantUser   User?         @relation("CurrentTenantUnits", fields: [tenantUserId], references: [id], onDelete: SetNull)
  currentApplication Application? @relation("CurrentTenantApplication", fields: [currentApplicationId], references: [id], onDelete: SetNull)
  propertyManager User?      @relation("UnitPropertyManagers", fields: [propertyManagerUserId], references: [id], onDelete: SetNull)
  maintenanceUser User?      @relation("UnitMaintenanceAssignees", fields: [maintenanceUserId], references: [id], onDelete: SetNull)
  caseworker User?           @relation("UnitCaseworkers", fields: [caseworkerUserId], references: [id], onDelete: SetNull)
  leads        Lead[]
  applications Application[]
  favoriteRentals FavoriteRental[]
  utilityAccounts UtilityAccount[]
  tenantPayments TenantPayment[]
  rentBillingPolicy RentBillingPolicy?
  scheduledPayments ScheduledPayment[]
  paymentEvents PaymentEvent[]
  autoPayEnrollments AutoPayEnrollment[]
  paymentRetryAttempts PaymentRetryAttempt[]
  financialAdjustments FinancialAdjustment[]
  ownerStatements OwnerStatement[]
  paymentDisputes PaymentDispute[]
  vendorPayouts VendorPayout[]
  securityDepositAccounts SecurityDepositAccount[]
  accountingExports AccountingExport[]
  creditReportingRecords CreditReportingRecord[]
  financialInsightSnapshots FinancialInsightSnapshot[]
  inspections  Inspection[]
  maintenanceRequests MaintenanceRequest[]
  documents    Document[]
  photos       UnitPhoto[]
  ledgerEntries LedgerEntry[]
  recurringChargeSchedules RecurringChargeSchedule[]
  paymentPlans PaymentPlan[]
  profileConnections ProfileConnection[]

  @@index([propertyId])
  @@index([tenantUserId])
  @@index([currentApplicationId])
  @@index([propertyManagerUserId])
  @@index([maintenanceUserId])
  @@index([caseworkerUserId])
  @@index([status])
  @@unique([propertyId, unitNumber])
}

model UnitPhoto {
  id           String   @id @default(cuid())
  unitId       String
  title        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  sortOrder    Int      @default(0)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([unitId, isFeatured])
  @@index([unitId, sortOrder])
}


model Lead {
  id        String     @id @default(cuid())
  unitId    String
  name      String
  email     String
  phone     String?
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  notes       LeadNote[]
  application Application?

  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  note      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model Application {
  id              String            @id @default(cuid())
  leadId          String?           @unique
  unitId          String
  applicantUserId String?
  applicantName   String
  applicantEmail String
  applicantPhone String?
  status         ApplicationStatus @default(STARTED)
  summary        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applicantUser User?             @relation(fields: [applicantUserId], references: [id], onDelete: SetNull)
  notes         ApplicationNote[]
  documents     Document[]
  documentRequests DocumentRequest[]
  leasePackets LeasePacket[]
  inspections Inspection[]
  maintenanceRequests MaintenanceRequest[]
  messageThreads MessageThread[]
  vendorPayouts VendorPayout[]
  ledgerEntries LedgerEntry[]
  recurringChargeSchedules RecurringChargeSchedule[]
  paymentPlans PaymentPlan[]
  claimTokens ApplicationClaimToken[]
  currentTenantUnits Unit[] @relation("CurrentTenantApplication")
  utilityAccounts UtilityAccount[]
  tenantPayments TenantPayment[]

  @@index([unitId])
  @@index([applicantUserId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  note          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}


model ApplicantProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  legalName       String
  preferredName   String?
  phone           String?
  currentAddress  String?
  city            String?
  state           String?
  zip             String?
  householdSize   Int?
  rentalHistory   String?
  desiredBedrooms Int?
  desiredBathrooms Float?
  maxRent          Int?
  desiredMoveInDate DateTime?
  voucherHolder    Boolean @default(false)
  pets             String?
  accessibilityNeeds String?
  landlordReferences String?
  employmentSummary String?
  renterBio        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdMembers HouseholdMember[]
  incomeSources    IncomeSource[]
}

model HouseholdMember {
  id          String                @id @default(cuid())
  profileId   String
  name        String
  relationship HouseholdRelationship @default(OTHER)
  age         Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  profile ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model IncomeSource {
  id          String          @id @default(cuid())
  profileId   String
  sourceName  String
  amount      Int
  frequency   IncomeFrequency @default(MONTHLY)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  profile ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model FavoriteRental {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
  @@index([createdAt])
}

model UtilityAccount {
  id            String               @id @default(cuid())
  userId        String
  unitId        String?
  applicationId String?
  providerName  String
  serviceType   String
  accountNumber String?
  status        UtilityAccountStatus @default(SETUP_NEEDED)
  dueDayOfMonth Int?
  averageAmount Int?
  autopayEnabled Boolean             @default(false)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([unitId])
  @@index([applicationId])
  @@index([status])
  @@index([dueDayOfMonth])
}

model PayrollReminder {
  id          String           @id @default(cuid())
  userId      String
  employerName String
  frequency   PayrollFrequency @default(BIWEEKLY)
  nextPayDate DateTime?
  typicalAmount Int?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextPayDate])
}

model TenantPayment {
  id            String              @id @default(cuid())
  userId        String
  unitId        String
  applicationId String?
  ledgerEntryId String?
  amount        Int
  method        TenantPaymentMethod @default(ACH)
  status        TenantPaymentStatus @default(PLANNED)
  dueDate       DateTime?
  submittedAt   DateTime?
  confirmation  String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([unitId])
  @@index([applicationId])
  @@index([ledgerEntryId])
  @@index([status])
  @@index([dueDate])
}


model Document {
  id            String             @id @default(cuid())
  title         String
  category      DocumentCategory   @default(OTHER)
  status        DocumentStatus     @default(UPLOADED)
  visibility    DocumentVisibility @default(INTERNAL)
  fileName      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  sha256Hash    String?
  notes         String?
  applicationId String?
  propertyId    String?
  unitId        String?
  leasePacketId String?
  uploadedById  String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leasePacket LeasePacket? @relation(fields: [leasePacketId], references: [id], onDelete: SetNull)
  uploadedBy  User?        @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("ReviewedDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)
  fulfilledRequests DocumentRequest[] @relation("FulfilledDocumentRequests")

  @@index([applicationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
