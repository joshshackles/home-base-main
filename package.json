    "update13:verify": "tsx scripts/verify-update13-tenant-dashboard.ts",
    "relationship:lifecycle:verify": "tsx scripts/verify-relationship-lifecycle-completion.ts",
    "relationship-contacts:verify": "tsx scripts/verify-relationship-contact-network.ts",
