# Use the Neon pooled connection string for app traffic.
# The app also accepts Vercel/Neon aliases: POSTGRES_PRISMA_URL, POSTGRES_URL, or NEON_DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&schema=public"

# Use the Neon direct connection string for Prisma migrations.
# The app also accepts aliases: POSTGRES_URL_NON_POOLING, POSTGRES_URL_NON_POOLING_DIRECT, or NEON_DIRECT_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&schema=public"

# Change this to a long random value before deploying.
AUTH_SECRET="replace-this-with-a-long-random-secret"

# Used by deployment checks and future email/link generation.
APP_URL="http://localhost:3000"

# Use s3 on production Vercel deployments. Use database only for small/private deployments; use local only for local development.
DOCUMENT_STORAGE_PROVIDER="s3"

# Optional when DOCUMENT_STORAGE_PROVIDER=local.
DOCUMENT_UPLOAD_DIR="./storage/documents"

# Email delivery. Use console locally, resend/webhook in production, or disabled to keep records unsent.
EMAIL_PROVIDER="console"
EMAIL_FROM="HomeBase MLS <no-reply@example.com>"
EMAIL_SEND_ON_QUEUE="false"
RESEND_API_KEY=""
EMAIL_WEBHOOK_URL=""

# Optional public lead form spam protection. Set REQUIRE_TURNSTILE=true in production
# after adding both Cloudflare Turnstile keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
REQUIRE_TURNSTILE="false"

# Rate limiting
# By default, the durable rate limiter fails closed if the database cannot be reached.
# Set this to true only for local development emergencies.
RATE_LIMIT_FAIL_OPEN=false

# Optional seed passwords. If omitted, strong temporary passwords are generated and printed during seeding.
SEED_ADMIN_PASSWORD=""
SEED_LANDLORD_PASSWORD=""
SEED_APPLICANT_PASSWORD=""

# Object storage for production documents. Supports AWS S3, Cloudflare R2, MinIO, and other S3-compatible services.
# Set DOCUMENT_STORAGE_PROVIDER="s3" in production to avoid storing large document bytes in Postgres.
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_REGION="auto"
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_ACCESS_KEY_ID=""
DOCUMENT_S3_SECRET_ACCESS_KEY=""
DOCUMENT_S3_PREFIX="documents"
DOCUMENT_S3_FORCE_PATH_STYLE="false"
DOCUMENT_S3_SERVER_SIDE_ENCRYPTION="AES256"

# Cron protection for /api/cron/send-queued-email.
# vercel.json registers this cron route. Vercel sends Authorization: Bearer $CRON_SECRET when CRON_SECRET is set.
CRON_SECRET=""
EMAIL_QUEUE_BATCH_SIZE="50"
EMAIL_MAX_ATTEMPTS="5"

# Update 11: structured logging
LOG_LEVEL=info
