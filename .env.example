DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Change this to a long random value before deploying.
AUTH_SECRET="replace-this-with-a-long-random-secret"

# Used by deployment checks and future email/link generation.
APP_URL="http://localhost:3000"

# Optional: local protected storage path for uploaded documents. Defaults to ./storage/documents.
DOCUMENT_UPLOAD_DIR="./storage/documents"

# Email delivery. Use console locally, resend/webhook in production, or disabled to keep records unsent.
EMAIL_PROVIDER="console"
EMAIL_FROM="HomeBase MLS <no-reply@example.com>"
EMAIL_SEND_ON_QUEUE="false"
RESEND_API_KEY=""
EMAIL_WEBHOOK_URL=""
